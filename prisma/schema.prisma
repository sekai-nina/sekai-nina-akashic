generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  member
  viewer
}

enum AssetKind {
  image
  video
  audio
  text
  document
  other
}

enum AssetStatus {
  inbox
  triaging
  organized
  archived
}

enum TrustLevel {
  unverified
  low
  medium
  high
  official
}

enum SourceType {
  web
  manual
  discord
  import
}

enum StorageProvider {
  gdrive
  discord_url
  external_url
  local_none
}

enum EntityType {
  person
  place
  source
  event
  tag
}

enum TextType {
  title
  body
  description
  message_body
  ocr
  transcript
  note
  extracted
  annotation
}

enum SourceKind {
  url
  discord_message
  drive_file
  manual
  other
}

enum AnnotationKind {
  note
  time_range
  text_span
  region
}

enum RelationType {
  parent_child
  derived_from
  reference
  same_content
}

enum ClearanceLevel {
  public
  internal
  confidential
  restricted
}

enum DossierAccessMode {
  private
  clearance
}

/// ドシエの役割 (#41)。
/// - general: 通常のドシエ (特定支援・記事の素材)
/// - clips: 「クリップ」プール。**全体で 1 本だけ** (部分ユニーク索引 `Dossier_clips_singleton` で担保)。
///   記事未定の抜粋をここに溜め、あとから別ドシエへ移す。削除・アクセス設定の変更は domain で拒否する
enum DossierKind {
  general
  clips
}

enum DossierItemKind {
  asset_ref
  external_link
  external_image
}

enum PlaceStatus {
  confirmed
  candidate
}

// 聖地の種類。公開サイトの聖地マップでピンのアイコンと絞り込みに使う
// (sekai-nina-site の src/utils/places.ts PlaceKind と同じ値の集合)。
// 未設定 (null) の場所はサイト側が名前・説明から推定する
enum PlaceKind {
  food // グルメ
  leisure // レジャー
  scenery // 寺社・公園・景色
  venue // 会場・放送局
  shop // 店・施設
}

enum DataSourceKind {
  blog
  talk
  tv
  youtube
  sns
  radio
  magazine
  live_event
  other
}

enum CoverageStatus {
  tracked
  not_applicable
}

enum ItemRule {
  blog_url
  talk_date
  source_url
  manual
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  role         Role           @default(member)
  clearance    ClearanceLevel @default(internal)
  avatarUrl    String?
  discordId    String?        @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  createdAssets       Asset[]          @relation("AssetCreatedBy")
  updatedAssets       Asset[]          @relation("AssetUpdatedBy")
  assetTexts          AssetText[]      @relation("AssetTextCreatedBy")
  annotations         Annotation[]     @relation("AnnotationCreatedBy")
  dossiers            Dossier[]
  dossierItemsCreated DossierItem[]    @relation("DossierItemCreatedBy")
  auditLogs           AuditLog[]
  apiKeys             ApiKey[]
  invitation          Invitation?
  aiSettings          AiSetting[]
  createdInvitations  Invitation[]     @relation("InvitationCreatedBy")
  meetGreets          MeetGreet[]      @relation("MeetGreetCreatedBy")
  creditSnapshots     CreditSnapshot[] @relation("CreditSnapshotCreatedBy")
}

model Asset {
  id                 String          @id @default(cuid())
  kind               AssetKind
  title              String          @default("")
  description        String          @default("")
  status             AssetStatus     @default(inbox)
  trustLevel         TrustLevel      @default(unverified)
  canonicalDate      DateTime?
  originalFilename   String?
  mimeType           String?
  fileSize           Int?
  sha256             String?
  sourceType         SourceType      @default(manual)
  storageProvider    StorageProvider @default(local_none)
  storageKey         String?
  storageUrl         String?
  thumbnailUrl       String?
  messageBodyPreview String?
  classification     ClearanceLevel  @default(internal)

  // Discord metadata
  discordGuildId    String?
  discordChannelId  String?
  discordMessageId  String?
  discordMessageUrl String?
  discordAuthorId   String?
  discordAuthorName String?
  discordPostedAt   DateTime?

  createdById String?
  createdBy   User?   @relation("AssetCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("AssetUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  texts             AssetText[]
  entities          AssetEntity[]
  sourceRecords     SourceRecord[]
  annotations       Annotation[]
  dossierItems      DossierItem[]
  testimonials      Testimonial[]
  relationsAsSource AssetRelation[] @relation("RelationSource")
  relationsAsTarget AssetRelation[] @relation("RelationTarget")
  articleSources    ArticleSource[]
  anniversaries     Anniversary[]

  @@index([sha256])
  @@index([status])
  @@index([kind])
  @@index([sourceType])
  @@index([trustLevel])
  @@index([canonicalDate])
  @@index([createdAt])
  @@index([classification])
}

model AssetText {
  id                String   @id @default(cuid())
  assetId           String
  asset             Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  textType          TextType
  content           String
  normalizedContent String   @default("")
  language          String?

  createdById String?
  createdBy   User?   @relation("AssetTextCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
}

model Entity {
  id             String     @id @default(cuid())
  type           EntityType
  canonicalName  String
  normalizedName String     @default("")
  aliases        Json       @default("[]")
  description    String     @default("")
  /// 日向坂46の期別 (person のみ。1〜5)
  generation     Int?
  /// 五十音順の並び替え用の読み仮名 (ひらがな)
  reading        String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  assets       AssetEntity[]
  testimonials Testimonial[]
  place        Place?

  @@unique([type, canonicalName])
}

model AssetEntity {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  roleLabel String?
  createdAt DateTime @default(now())

  @@unique([assetId, entityId])
  @@index([assetId])
  @@index([entityId])
}

model SourceRecord {
  id          String     @id @default(cuid())
  assetId     String
  asset       Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sourceKind  SourceKind
  title       String     @default("")
  url         String?
  publisher   String?
  publishedAt DateTime?
  metadata    Json       @default("{}")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([assetId])
}

model Annotation {
  id        String         @id @default(cuid())
  assetId   String
  asset     Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind      AnnotationKind
  body      String
  startMs   Int?
  endMs     Int?
  textStart Int?
  textEnd   Int?
  bbox      Json?

  createdById String
  createdBy   User   @relation("AnnotationCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
}

model Dossier {
  id             String            @id @default(cuid())
  ownerId        String
  owner          User              @relation(fields: [ownerId], references: [id])
  title          String
  summary        String            @default("")
  classification ClearanceLevel    @default(internal)
  viewMode       DossierAccessMode @default(private)
  editMode       DossierAccessMode @default(private)
  kind           DossierKind       @default(general)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items           DossierItem[]
  placeCandidates DossierPlaceCandidate[]
  meetGreet       MeetGreet?
  /// このドシエを素材にした記事 (`Article.dossierId`)。1 本のドシエから複数記事を許す
  articles        Article[]

  @@index([ownerId])
  @@index([classification])
  @@index([updatedAt])
  @@index([kind])
}

model DossierItem {
  id        String          @id @default(cuid())
  dossierId String
  dossier   Dossier         @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  kind      DossierItemKind @default(asset_ref)

  // kind=asset_ref
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // kind=external_link
  externalUrl String?

  // kind=external_image (stored in R2)
  externalImageKey      String?
  externalImageThumbKey String?

  // Common metadata
  caption String @default("")
  note    String @default("")

  // Excerpt (range selection from AssetText)
  excerpt      String    @default("")
  excerptType  TextType?
  excerptStart Int?
  excerptEnd   Int?

  /// 入れた人 (#41)。クリップの一覧で「自分のだけ」に絞るため。#41 以前の行は null
  createdById String?
  createdBy   User?   @relation("DossierItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NOTE: intentionally no @@unique([dossierId, assetId]) — a single asset can
  // be added to a dossier multiple times, once per excerpt (range selection).
  @@index([dossierId])
  @@index([assetId])
  @@index([createdById])
}

model DossierPlaceCandidate {
  id        String  @id @default(cuid())
  dossierId String
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  placeId   String?
  place     Place?  @relation(fields: [placeId], references: [id], onDelete: SetNull)

  // Inline fallback fields when placeId is null
  name          String   @default("")
  latitude      Float?
  longitude     Float?
  address       String?
  googleMapsUrl String?
  note          String   @default("")
  confidence    Int      @default(0)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([dossierId])
  @@index([placeId])
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique
  keyPrefix   String // 先頭8文字を保持（UI表示用）
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  permissions Json      @default("[\"read\",\"write\"]") // 許可する操作
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([keyHash])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model AssetRelation {
  id           String       @id @default(cuid())
  sourceId     String
  source       Asset        @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId     String
  target       Asset        @relation("RelationTarget", fields: [targetId], references: [id], onDelete: Cascade)
  relationType RelationType
  metadata     Json         @default("{}")
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())

  @@unique([sourceId, targetId, relationType])
  @@index([sourceId, relationType])
  @@index([targetId, relationType])
}

model Invitation {
  id          String         @id @default(cuid())
  token       String         @unique @default(cuid())
  email       String?
  role        Role           @default(member)
  clearance   ClearanceLevel @default(internal)
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?        @unique
  usedBy      User?          @relation(fields: [usedById], references: [id])
  createdById String
  createdBy   User           @relation("InvitationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())

  @@index([token])
  @@index([createdById])
}

enum TestimonialStatus {
  pending
  approved
  rejected
}

enum TestimonialCategory {
  personality
  performance
  relationship
}

model Testimonial {
  id       String @id @default(cuid())
  assetId  String
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  quote           String
  trait           String              @default("")
  category        TestimonialCategory @default(personality)
  speakerName     String
  speakerEntityId String?
  sourceUrl       String?
  sourceDate      DateTime?

  status     TestimonialStatus @default(pending)
  confidence Float             @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  reviewedAt DateTime?

  @@unique([assetId, entityId, quote])
  @@index([entityId, status])
  @@index([category])
  @@index([status])
}

model Place {
  id             String         @id @default(cuid())
  entityId       String         @unique
  entity         Entity         @relation(fields: [entityId], references: [id], onDelete: Cascade)
  latitude       Float
  longitude      Float
  googleMapsUrl  String?
  address        String?
  kind           PlaceKind?
  // 聖地マップのエリア (「東京」「横浜・川崎」「名古屋」等)。人が付ける自由文字列。
  // 公開サイトの絞り込み・低ズームのまとまりに使う。未設定はサイト側で「その他」扱い
  area           String?
  classification ClearanceLevel @default(internal)
  status         PlaceStatus    @default(confirmed)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  dossierCandidates DossierPlaceCandidate[]

  @@index([latitude, longitude])
  @@index([classification])
  @@index([status])
}

// ============================================================
// レポ収集 (curepo 由来) — Twitter ミーグリレポ収集・選別
// ============================================================

enum RepoTweetStatus {
  undecided
  keep
  reject
}

model RepoCollection {
  id              String         @id @default(cuid())
  name            String
  groups          Json // [{ tags: string[], op: "and" | "or" }]
  groupOp         String         @default("or")
  query           String // 構築済み X API クエリ（日付は別送信）
  startDate       String? // JST "YYYY-MM-DD"（TZ事故回避のため文字列保持）
  endDate         String?
  excludeRetweets Boolean        @default(true)
  langJa          Boolean        @default(true)
  extra           String         @default("")
  classification  ClearanceLevel @default(internal)
  sourceLegacyId  Int?           @unique // 移行の冪等化（curepo の整数 id）
  lastFetchedAt   DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tweets    RepoTweet[]
  meetGreet MeetGreet?

  @@index([classification])
}

model RepoTweet {
  id             String          @id @default(cuid())
  collectionId   String
  collection     RepoCollection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  tweetId        String
  authorUsername String          @default("")
  authorName     String          @default("")
  text           String          @default("")
  tweetedAt      DateTime?
  likeCount      Int             @default(0)
  retweetCount   Int             @default(0)
  replyCount     Int             @default(0)
  quoteCount     Int             @default(0)
  url            String
  status         RepoTweetStatus @default(undecided)
  note           String          @default("")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  media RepoTweetMedia[]

  @@unique([collectionId, tweetId])
  @@index([collectionId, status])
}

model RepoTweetMedia {
  id        String    @id @default(cuid())
  tweetId   String
  tweet     RepoTweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  mediaKey  String
  type      String    @default("photo") // photo | video | animated_gif
  remoteUrl String? // 元 Twitter 画像URL（参照/再取得用）
  imageKey  String? // R2 key（640px WebP）
  width     Int?
  height    Int?
  altText   String    @default("")

  @@unique([tweetId, mediaKey])
}

// ============================================================
// 収集カバレッジ管理 (観点 × データソース)
// 「どの観点を、どのデータソースに、何日の分まで反映したか」を記録する。
// 3 モデルとも classification を持ち、RLS は Place/RepoCollection と同じ
// direct-classification パターン。public は「公開サイトの鮮度表示に出すか」
// で classification とは別関心事。
// ============================================================

model Lens {
  id             String          @id @default(cuid())
  key            String          @unique // 機械名: live, meetgreet, food, possessions, ...
  name           String // 表示名: ライブ, ミーグリ, 食べたもの, ...
  description    String // 観点の詳細説明（何を拾うか・拾わないか）
  sortOrder      Int             @default(0)
  active         Boolean         @default(true)
  public         Boolean         @default(true) // 公開サイトの鮮度表示に出すか
  classification ClearanceLevel  @default(internal)
  coverages      Coverage[]
  itemChecks     LensItemCheck[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([classification])
}

model DataSource {
  id               String          @id @default(cuid())
  key              String          @unique // blog, talk, hinaai, hinachan, ...
  name             String
  kind             DataSourceKind
  description      String?
  sortOrder        Int             @default(0)
  active           Boolean         @default(true)
  public           Boolean         @default(true)
  classification   ClearanceLevel  @default(internal)
  // v2: アイテム導出規則。itemRule に応じて SourceRecord/Asset からアイテムを導出する。
  itemRule         ItemRule        @default(manual)
  publisherPattern String? // SourceRecord.publisher への SQL LIKE（null=不問）
  titlePattern     String? // SourceRecord.title への SQL LIKE（null=不問。番組回の切り分け用）
  coverages        Coverage[]
  itemChecks       LensItemCheck[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([classification])
}

model Coverage {
  id             String         @id @default(cuid())
  lensId         String
  lens           Lens           @relation(fields: [lensId], references: [id], onDelete: Cascade)
  dataSourceId   String
  dataSource     DataSource     @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  status         CoverageStatus @default(tracked)
  note           String? // 内部メモ（公開しない）
  classification ClearanceLevel @default(internal)
  updatedById    String?
  updatedAt      DateTime       @updatedAt
  createdAt      DateTime       @default(now())

  @@unique([lensId, dataSourceId])
  @@index([dataSourceId])
  @@index([classification])
}

// v2: アイテム単位チェックの本体。「このアイテム(itemKey)をこの観点(Lens)で見た」の記録。
// アイテムは DataSource.itemRule で SourceRecord/Asset から導出する（テーブル実体化しない）。
model LensItemCheck {
  id             String         @id @default(cuid())
  lensId         String
  lens           Lens           @relation(fields: [lensId], references: [id], onDelete: Cascade)
  dataSourceId   String
  dataSource     DataSource     @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  itemKey        String // url または "YYYY-MM-DD"
  itemDate       DateTime? // 導出時点のスナップショット（表示・連続日付導出用）
  itemTitle      String? // 表示用スナップショット
  note           String?
  classification ClearanceLevel @default(internal)
  checkedById    String?
  checkedAt      DateTime       @default(now())

  @@unique([lensId, dataSourceId, itemKey])
  @@index([dataSourceId, itemDate])
  @@index([classification])
}

// ---------------------------------------------------------------------------
// 記事 (世界新奈)
//
// 実体は別リポジトリ sekai-nina/sekai-nina-public の Markdown。
// akashic 側の DB を編集バッファとし、溜まったら一括で GitHub へ push する
// (= GitHub は出力先に徹する)。したがって DB が単一の真実で、frontmatter は
// push 時に丸ごと生成する。
// ---------------------------------------------------------------------------

/// sekai-nina-site の src/content/config.ts の enum と揃える (fact / state は
/// Astro 側の transform で attribute に畳まれるので持たない)。ここに無い値を
/// push すると Astro のビルドが落ちるため、足すときは両側を同時に変える。
enum ArticleType {
  attribute
  event
  quote
  column
  item
}

/// ArticleSource が記事本文に反映済みか。
/// - applied: frontmatter の source[] に載っており、本文が脚注で参照している
/// - pending: akashic 側で紐づけただけ。AI / 人が本文に反映する対象
/// - unresolved: 元の ref が akashic に実在しない (取り込み時に検出)。要調査
enum ArticleSourceStatus {
  applied
  pending
  unresolved
}

/// 公開記事のミラー。公開サイトに出る内容なので**非保護テーブル** (素の prisma で扱う)。
model Article {
  id      String       @id @default(cuid())
  /// frontmatter の short_id。全記事に振られている安定 ID
  shortId String       @unique
  /// リポジトリ内のパス (例: attribute/癖.md)
  path    String       @unique
  slug    String?
  title   String       @default("")
  type    ArticleType?
  tags    Json         @default("[]")

  /// 本文 (frontmatter を除いた Markdown)
  body String @default("")

  // frontmatter の日付系
  date             DateTime?
  dateDisplay      String?
  dateMode         String?
  publishedAt      DateTime?
  /// frontmatter の updated_at (レコードの updatedAt とは別物)
  articleUpdatedAt DateTime?

  draft    Boolean @default(false)
  unlisted Boolean @default(false)
  ongoing  Boolean @default(false)

  lat Float?
  lng Float?

  /// 本モデルで持たない frontmatter (featured_quotes / locations / dossier 等) の退避先。
  /// push 時に frontmatter を丸ごと生成するため、ここに残さないと元データを壊す。
  frontmatterExtra Json @default("{}")

  /// 取り込み元 blob の SHA。push 時の衝突検出に使う
  githubSha    String?
  /// DB から組み立てた Markdown ≠ GitHub 側のファイル (取り込み直後の正規化差分でも立つ)
  dirty        Boolean   @default(false)
  /// akashic 側で編集した日時。**非 null ⇔ 未 push の akashic 編集がある** (#89)。
  /// 編集の保存が now を書き、push で dirty を落とすときと取り込みで上書きしたときに null に戻す。
  /// 取り込みはこれが非 null の記事 (ファイル未変更のもの) をスキップして編集を守る
  editedAt     DateTime?
  lastSyncedAt DateTime?
  lastPushedAt DateTime?

  /// 素材ドシエ (#41)。クリップを「この記事に足す」ときの移動先。akashic 内部のリンクで
  /// frontmatter には出さない (旧ワークフローの `frontmatterExtra.dossier` はそのまま残す)。
  /// ドシエが消えたら null に戻る
  dossierId String?
  dossier   Dossier? @relation(fields: [dossierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sources       ArticleSource[]
  meetGreet     MeetGreet?
  anniversaries Anniversary[]

  @@index([type])
  @@index([dirty])
  @@index([publishedAt])
  @@index([dossierId])
}

/// 記事とアセットの紐づけ。記事 frontmatter の source[] 1 要素に対応する。
/// アセット本文の抜粋を持つので **保護テーブル** (withClearance 経由で扱う)。
/// 抜粋の持ち方は DossierItem と同形。同一アセットを抜粋ごとに複数回紐づけられるよう、
/// 意図的に @@unique([articleId, assetId]) を持たない。
model ArticleSource {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  /// unresolved のときは null。Asset が後から消されても SetNull で null になる
  /// (元ファイルに ref があった行は originalRef に残るので、push でその ref は消えない)
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  status ArticleSourceStatus @default(pending)

  /// 記事内の脚注番号 (frontmatter source[].id)。本文の ^[n] と対応する
  sourceNo    Int?
  label       String    @default("")
  url         String?
  date        DateTime?
  /// 元ファイルの source[].ref をそのまま保持する (status に依らず)。
  /// push 時の ref は `assetId ?? originalRef` で決める。applied でも持っておくと、
  /// Asset が消されて assetId が SetNull されたときに元の ref を書き戻せる。
  /// akashic 側で付けた紐づけ (pending 由来) は元ファイルに無いので null
  originalRef String?

  // 抜粋 (AssetText からの範囲選択)。DossierItem と同形
  excerpt      String    @default("")
  excerptType  TextType?
  excerptStart Int?
  excerptEnd   Int?

  note           String         @default("")
  sortOrder      Int            @default(0)
  /// frontmatter 由来 (applied / unresolved) は公開リポジトリに載っているので public。
  /// akashic 側で付けた紐づけは元アセットの classification を継承する。
  /// **push で frontmatter に載るのは public の行だけ** (src/lib/articles/frontmatter.ts)。
  /// 既定値は書き忘れた経路が fail-open にならないよう internal のまま
  classification ClearanceLevel @default(internal)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId])
  @@index([assetId])
  @@index([status])
  @@index([classification])
}

// ---------------------------------------------------------------------------
// パイプライン監視 (/status)
//
// bot や外部ワーカーの各ジョブが実行結果を報告する受け口 (Job / JobRun) と、
// Cron が評価したチェックの現在状態 (StatusCheckState)。いずれも件数・時刻・
// メッセージしか持たない運用情報なので非保護 (RLS 対象外、素の prisma で触る)。
// ---------------------------------------------------------------------------

enum JobRunStatus {
  ok
  error
}

enum StatusLevel {
  ok
  warn
  error
  unknown
}

/// ハートビートを報告するジョブ。初回の報告で自動作成される
model Job {
  id          String @id @default(cuid())
  /// 報告側が名乗る識別子 (bot.blog_watch / worker.stats など)
  key         String @unique
  name        String
  /// 報告側が申告する実行間隔 (秒)。null なら「報告が途絶えた」判定をしない
  intervalSec Int?

  lastRunAt   DateTime?
  lastOkAt    DateTime?
  lastStatus  JobRunStatus?
  lastMessage String        @default("")

  runs JobRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// ジョブの実行履歴。ok で count=0 の報告が続くときは行を増やさない (Job.lastOkAt だけ更新)
model JobRun {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  status     JobRunStatus
  message    String       @default("")
  /// 処理した件数 (登録した記事数など)。報告側が任意で付ける
  count      Int?
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([createdAt])
}

/// チェックごとの現在状態。Cron の評価結果を保存し、通知の遷移判定と /status の表示に使う。
/// 表示に要る名前・グループも評価時に写しておく (/status は保護テーブルを読まずにこの表だけで描ける)
model StatusCheckState {
  id  String @id @default(cuid())
  key String @unique

  /// CHECK_GROUP_LABELS のキー (collect / process / articles / workers)
  group       String
  name        String
  description String  @default("")
  /// false は件数を眺めるだけの info チェック (Discord に通知しない)
  notify      Boolean @default(true)

  status  StatusLevel
  summary String      @default("")
  /// 一覧に出す補足 (アセット ID や記事の shortId など)。形はチェックごと
  detail  Json        @default("{}")

  /// 現在の status になった時刻
  since          DateTime
  evaluatedAt    DateTime
  lastNotifiedAt DateTime?
  /// 最後に Discord へ通知できた (または通知不要と判断して同期した) status。
  /// 通知の遷移判定はこれと今回の status を比べる (前回の status ではない)。
  /// 送信に失敗した回はここが進まないので、次の評価で同じ遷移をもう一度送れる
  notifiedStatus StatusLevel?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// ミーグリ記事の作成ワークフロー (#106)
// 1 回のミーグリにつき 1 行。素材置き場のドシエ・X レポの RepoCollection・
// 生成した記事を束ね、スケッチ候補と確定を持つ。ドシエ / /repo / 記事の
// 各画面はそのまま使い、ここは「どこまで進んだか」と横断の紐づけだけを持つ。
// ============================================================

enum MeetGreetFormat {
  online
  real
}

/// 保護テーブル。classification の direct-classification RLS (Place / RepoCollection と同形)。
/// ドシエは所有者判定があるので、ドシエを include する読みは withSession で行う。
model MeetGreet {
  id     String          @id @default(cuid())
  /// 開催日 (JST "YYYY-MM-DD")。RepoCollection.startDate と同じく文字列で持つ (TZ 事故回避)
  date   String
  format MeetGreetFormat
  /// シングル名 (例: 17thシングル「Kind of love」)。記事 frontmatter の meetgreet.single に出る
  single String          @default("")
  /// 回の呼び分け (「通常」「初回限定盤」「京都」など)。ドシエ / コレクションの名前に使うだけで記事には出ない
  label  String          @default("")
  /// 会場の正式名称 (「幕張メッセ」など)。**リアルミーグリの記事タイトルに出る**。
  /// label が短い通称 (幕張) なのに対し、こちらは表に出す名前。オンラインでは使わない
  venue  String?

  classification ClearanceLevel @default(internal)

  /// 素材置き場。作成時に自動で作る (1:1)。ドシエが消えたらこの行も消す
  dossierId String  @unique
  dossier   Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  /// X レポの収集。作成時に自動で作る。コレクションだけ消しても行は残す
  repoCollectionId String?         @unique
  repoCollection   RepoCollection? @relation(fields: [repoCollectionId], references: [id], onDelete: SetNull)

  /// 生成した記事 (PR3 で埋まる)
  articleId String?  @unique
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  /// スケッチ候補の R2 key の配列 (PR2 で使う)
  sketchCandidates  Json    @default("[]")
  /// 確定したスケッチの R2 key。記事のサムネになる
  sketchKey         String?
  /// スケッチ生成時にプロンプト本体へ追記する、この回だけの指示
  extraSketchPrompt String  @default("")

  /// 記事に**足さない**と決めたもののキー (#134)。
  /// 追記は「記事の本文に無い = まだ足していない」としか判断できず、人が意図的に消したものを
  /// 区別できない (X 側で削除されたレポを手で消しても、次の追記で復活する)。外したものを
  /// ここに覚えて二度と提示しない。
  /// 形式: `report:<statusId>` / `asset:<assetId>` / `tiktok:<videoId>` / `quote:<先頭行のハッシュ>`
  /// (`20260920100000_meetgreet_article_exclusions` のコメントは report を URL と書いているが、
  ///  実装は status ID。適用済み migration は書き換えられないのでここを正とする)
  articleExclusions Json @default("[]")

  createdById String
  createdBy   User   @relation("MeetGreetCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([classification])
}

// ---------------------------------------------------------------------------
// 記念日 (/anniversaries)
//
// 坂井新奈が「初めて〇〇した日」。公開サイトの「今日は〇〇の日」と記念日ページの正で、
// 366 日すべてを埋めるのが目標。ブログ / トークを読んでいる最中に「これ初〇〇だ」と
// 気づいた場面で登録するので、出典アセットをその場で紐づけられるようにしてある。
// 聖地 (Place) と同じく公開サイトはビルド時に API から取得する。
// 出典アセットの本文は持たないが、機密のアセットから作った記念日が漏れないよう
// 自前の classification で RLS を掛ける (保護テーブル)。
// ---------------------------------------------------------------------------

model Anniversary {
  id          String @id @default(cuid())
  /// 初めての日 (JST "YYYY-MM-DD")。MeetGreet.date と同じく文字列で持つ (TZ 事故回避)。
  /// 月日は毎年の記念日、年は「〇年前」の計算に使う
  date        String
  /// 呼び名 (例: 初ブログの日)。公開サイトの「今日は〇〇の日」にそのまま出る
  title       String
  /// 何があったかの一文
  description String @default("")

  /// 出典アセット (ブログ / トーク等)。アセットページから登録すると自動で入る
  assetId   String?
  asset     Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  /// 出典 URL。アセット化されていない公式ページ等に使う (assetId と併用可)
  sourceUrl String?
  /// 関連する公開記事。サイトの記念日からのリンク先
  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  classification ClearanceLevel @default(internal)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([assetId])
  @@index([articleId])
  @@index([classification])
}

// ---------------------------------------------------------------------------
// LLM の利用コストと残クレジット (/costs)
//
// 2 系統のデータを突き合わせる:
//   - プロバイダ由来 (LlmCostDaily): Admin キーで引いた**権威ある金額**。コードを通らない
//     利用 (手元の Claude Code 等) も含む。日次
//   - 自己申告 (LlmUsageDaily): 各呼び出し側が報告したトークン数。機能別の内訳が出せる。
//     価格表 (src/lib/costs/pricing.ts) で USD に換算する。**価格表に無いモデルは
//     costUsd を null にしてトークンだけ残す** (黙って 0 円にしない)
//
// 残高は 3 社とも API で読めないので、観測した残高を CreditSnapshot に 1 行入れ、
// 以降の支出を引いて推定する。いずれも金額・トークン数しか持たない運用情報なので
// 非保護 (RLS 対象外、素の prisma)。
// ---------------------------------------------------------------------------

enum LlmProvider {
  openai
  anthropic
  google
}

/// 金額の出どころ。provider が権威で、reported は内訳のための推定値
enum LlmUsageSource {
  reported
  provider
}

/// 日次 × プロバイダ × モデル × 機能のトークン集計 (自己申告 / プロバイダの usage API)
model LlmUsageDaily {
  id       String      @id @default(cuid())
  /// JST の暦日 (UTC 深夜で保持する。他の date-only 列と同じ扱い)
  date     DateTime    @db.Date
  provider LlmProvider
  model    String
  /// 呼び出し元の識別子 (akashic.testimonials / bot.discovery / worker.fitan_site など)。
  /// プロバイダ由来で内訳が分からないものは "unattributed"
  feature  String

  inputTokens       Int @default(0)
  cachedInputTokens Int @default(0)
  outputTokens      Int @default(0)
  requests          Int @default(0)

  /// 価格表で換算した金額。価格未登録のモデルは null
  costUsd Decimal?       @db.Decimal(12, 6)
  source  LlmUsageSource @default(reported)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, provider, model, feature, source])
  @@index([date])
  @@index([provider, date])
}

/// 日次 × プロバイダの確定コスト (プロバイダの costs API 由来)
model LlmCostDaily {
  id        String      @id @default(cuid())
  date      DateTime    @db.Date
  provider  LlmProvider
  /// USD。プロバイダが返した金額をそのまま入れる
  amountUsd Decimal     @db.Decimal(12, 6)
  /// 取り込み元の説明 (openai:costs / anthropic:cost_report)
  source    String      @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, provider])
  @@index([provider, date])
}

/// 観測した残高。入金したら「入金後の残高」を入れ直す (最新の 1 行が起点になる)
model CreditSnapshot {
  id          String      @id @default(cuid())
  provider    LlmProvider
  /// その残高を目視した時刻
  observedAt  DateTime
  /// 換算後の残高。社内の計算はすべてこれを使う
  balanceUsd  Decimal     @db.Decimal(12, 2)
  /// 目視した通貨での金額。Google Cloud の請求通貨が円のことがあるため原本を残す。
  /// 既定値 0 は**マイグレーションとデプロイの間**に旧コードが書き込んでも 500 にしないための保険
  amount      Decimal     @default(0) @db.Decimal(14, 2)
  /// ISO 4217 (USD / JPY)
  currency    String      @default("USD") @db.VarChar(3)
  /// 1 USD が何単位か。balanceUsd = amount / unitsPerUsd (USD なら 1)
  unitsPerUsd Decimal     @default(1) @db.Decimal(12, 4)
  note        String      @default("")

  createdById String?
  createdBy   User?   @relation("CreditSnapshotCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([provider, observedAt])
}

/// 案内AI「ふぃたん」に来た質問と回答の記録。
///
/// 何が聞かれているかを人が眺めて、アーカイブの穴を見つけるためのもの。
/// 個人を特定できる情報は受け取らない（IP・UA・リファラ・セッションIDは Worker 側でも保存していない）。
/// 1問1答ずつ独立した行で、同じ人の連続した質問を結び付ける手段は無い。
///
/// 公開している方針文（/ai）で「最大180日間保存」と約束しているので、
/// expiresAt を過ぎた行は消す（scripts/purge-ai-questions.ts）。
model AiQuestion {
  id String @id @default(cuid())

  askedAt       DateTime
  question      String
  answer        String
  /// 回答の根拠にした記事。[{title, url}] の配列
  citations     Json     @default("[]")
  /// 0 件なら答えられなかった質問。アーカイブの穴の候補
  citationCount Int      @default(0)
  /// 回答をキャッシュから返したか
  cached        Boolean  @default(false)
  /// 質問元。本番とプレビューを混ぜて数えないため
  origin        String   @default("")
  /// 会話の続きとして聞かれたか。
  /// 「わたしも深大寺行ったことあるよ！」のような行が単独の質問に見えてしまうため、
  /// 印だけ付ける。どの質問の続きなのかは保存しない（会話IDを持たないという約束を守る）
  followUp      Boolean  @default(false)

  /// 他のテーブルと同じくクリアランスの RLS を掛ける。
  /// 中身は公開サイトへの質問なので internal で十分だが、素通しの穴を作らないために揃える
  classification ClearanceLevel @default(internal)

  createdAt DateTime @default(now())
  /// 180日後。これを過ぎた行は削除する
  expiresAt DateTime

  @@index([askedAt])
  @@index([citationCount, askedAt])
  @@index([expiresAt])
  @@index([classification])
}

/// 案内AI「ふぃたん」の運転スイッチ。行は1つだけ（id = "singleton"）。
///
/// 止めたいときに、サイトを作り直さずに即座に止められるようにするためのもの。
/// Worker がここを見に来る（短いキャッシュ付き）。Akashic が落ちていても
/// Worker は最後に読めた値で動き続けるので、これが原因で AI が止まることはない。
model AiSetting {
  id      String  @id @default("singleton")
  /// false にすると、回答を止めたうえでサイトから入口ごと消える
  enabled Boolean @default(true)
  /// 止めた理由。運用の記録用で、利用者には出さない
  note    String  @default("")

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])

  classification ClearanceLevel @default(internal)
}
