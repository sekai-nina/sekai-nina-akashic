[Unit]
Description=Akashic 動画の場面候補を1件生成
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/akashic-video-scenes
EnvironmentFile=%h/.config/akashic-video-scenes/worker.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/systemctl --user start video-scenes-references.service
ExecStart=%h/sekai-nina-omokage/.venv/bin/python scripts/video-scene-worker.py --refs data/refs-full.npz --cache-dir %h/.cache/akashic-video-scenes --source-cache-dir %h/akashic-video-scenes/data/source-cache --drive-credentials %h/.config/akashic-video-scenes/drive-readonly.json --max-jobs 1 --discover
TimeoutStartSec=125min
Nice=15
CPUQuota=100%
MemoryMax=1800M
PrivateTmp=true
NoNewPrivileges=true

