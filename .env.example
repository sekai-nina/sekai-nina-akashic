# Supabase PostgreSQL
# DATABASE_URL: Transaction pooler (port 6543) — ランタイム接続 (app_runtime ロール, RLS 適用)
# DIRECT_URL:   Direct connection (port 5432) — マイグレーション + 内部ツール用 (postgres, RLS バイパス)
DATABASE_URL="postgresql://app_runtime.[project-ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ローカル開発用 (docker-compose.yml)
# DATABASE_URL="postgresql://akashic:akashic@localhost:5432/akashic?schema=public"
# DIRECT_URL="postgresql://akashic:akashic@localhost:5432/akashic?schema=public"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."   # サーバー側のみ。ユーザー管理に使用

# Google Drive (optional — OAuth2 方式: 個人ドライブ向け)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REFRESH_TOKEN=""      # pnpm tsx scripts/get-drive-token.ts で取得
# GOOGLE_DRIVE_FOLDER_ID=""

# Google Drive (optional — サービスアカウント方式: 共有ドライブ向け)
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# X (Twitter) API — レポ収集 (/repo) の recent search に必要 (Basic 以上の有料プラン)
X_BEARER_TOKEN=""

# 記事の GitHub push (/articles/push) — sekai-nina-public への書き込み
# fine-grained PAT。対象リポジトリだけに Contents: Read and write を付ける。
# 未設定なら push 画面は読み取り専用になる (GITHUB_TOKEN にしないのは Actions の自動注入と紛れるため)
# ARTICLES_GITHUB_TOKEN="github_pat_..."
# ARTICLES_GITHUB_REPO="sekai-nina/sekai-nina-public"   # 既定値。テスト用のフォークに向けるときだけ変える

# アプリの公開 URL — Discord bot と MCP が画面へのリンクを組み立てるのに使う
# 未設定ならリクエストのホストから推定する
AUTH_URL="http://localhost:3000"

# パイプライン監視 (/status)
# Vercel Cron が /api/cron/status を呼ぶときの Bearer。未設定なら cron は 503 で何もしない
# CRON_SECRET="<openssl rand -hex 32>"
# 注意・異常への変化と復旧を流す Discord の Incoming Webhook。未設定なら通知しない
# DISCORD_STATUS_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# LLM コスト管理 (/costs)
# プロバイダの日次コストを取り込む Admin キー。**通常の API キーとは別物**（各社のコンソールで発行する）。
# 未設定ならそのプロバイダは取り込みをスキップし、自己申告ぶんだけで推定する
# OPENAI_ADMIN_KEY="sk-admin-..."
# ANTHROPIC_ADMIN_KEY="sk-ant-admin..."
# Anthropic の api_key_id を機能名に読み替える対応表（任意）。未設定なら anthropic:<key id> のまま出る
# ANTHROPIC_KEY_FEATURES='{"apikey_01xxxx":"anthropic:nitan-discord"}'
# OpenAI も同様。キー名は Admin API から自動で引くので、名前が用途を表していないときだけ入れる
# OPENAI_KEY_FEATURES='{"key_xxxx":"openai:bot"}'
